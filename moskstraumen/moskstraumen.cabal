cabal-version:   3.0
name:            moskstraumen
version:         0.0.0

-- synopsis:
-- description:
license:         BSD-2-Clause
license-file:    LICENSE
author:          Stevan A
maintainer:      stevana@users.noreply.github.com

-- copyright:
category:        Testing
build-type:      Simple
extra-doc-files: CHANGELOG.md
data-dir:        data
data-files:
  chain.json
  context.json

flag debugger
  description: Enable building debugger
  default:     False
  manual:      True

common warnings
  ghc-options: -Wall

common extensions
  default-extensions:
    DeriveAnyClass
    DeriveFoldable
    DeriveFunctor
    DeriveGeneric
    DeriveTraversable
    DerivingStrategies
    DuplicateRecordFields
    GADTs
    GeneralizedNewtypeDeriving
    LambdaCase
    NamedFieldPuns
    NoImplicitPrelude
    NumericUnderscores
    OverloadedRecordDot
    OverloadedStrings
    ScopedTypeVariables
    StrictData

library
  import:           warnings, extensions
  exposed-modules:
    Moskstraumen.Codec
    Moskstraumen.Debugger.SequenceDiagram
    Moskstraumen.Debugger.State
    Moskstraumen.Effect
    Moskstraumen.Error
    Moskstraumen.EventLoop2
    Moskstraumen.Example.Amaru
    Moskstraumen.Example.Broadcast
    Moskstraumen.Example.CRDT.GSet
    Moskstraumen.Example.Echo
    Moskstraumen.Example.KeyValueStore
    Moskstraumen.Example.Raft
    Moskstraumen.Experiment.AwaitNode
    Moskstraumen.Experiment.AwaitNode3
    Moskstraumen.Experiment.Node5
    Moskstraumen.Experiment.Node6
    Moskstraumen.Experiment.Node7
    Moskstraumen.Experiment.Node8
    Moskstraumen.Experiment.PipelineNode
    Moskstraumen.Experiment.SourceSinkNode
    Moskstraumen.Experiment.SourceSinkNode2
    Moskstraumen.Experiment.SourceSinkNode3
    Moskstraumen.FakeTime
    Moskstraumen.FreeMonad
    Moskstraumen.Generate
    Moskstraumen.Heap
    Moskstraumen.LinearTemporalLogic
    Moskstraumen.Marshal
    Moskstraumen.Message
    Moskstraumen.Message2
    Moskstraumen.Message3
    Moskstraumen.Node4
    Moskstraumen.NodeHandle
    Moskstraumen.NodeId
    Moskstraumen.Parse
    Moskstraumen.Prelude
    Moskstraumen.Pretty
    Moskstraumen.Random
    Moskstraumen.Runtime.TCP
    Moskstraumen.Runtime2
    Moskstraumen.Shrink
    Moskstraumen.Simulate
    Moskstraumen.Simulate2
    Moskstraumen.Time
    Moskstraumen.TimerWheel2
    Moskstraumen.VarId
    Moskstraumen.Workload

  if flag(debugger)
    exposed-modules:
      Moskstraumen.Debugger.AnsiEscape
      Moskstraumen.Debugger.LibMain
      Moskstraumen.Debugger.UserInterface

  other-modules:    Paths_moskstraumen

  -- NOTE: GHC 9.2 is needed for OverloadedRecordDot and
  -- OverloadedRecordUpdate, and that version uses base 4.16.
  build-depends:
    , aeson       >=2.0.2.0
    , base        >=4.16
    , bytestring
    , containers
    , heaps
    , mtl
    , network
    , process
    , random
    , scientific
    , stm
    , text
    , time
    , vector

  if flag(debugger)
    build-depends:
      , brick
      , microlens
      , vty
      , vty-unix
      , word-wrap

  hs-source-dirs:   src
  default-language: Haskell2010

executable echo
  import:           warnings
  main-is:          Main.hs
  build-depends:
    , base
    , moskstraumen

  hs-source-dirs:   app/echo
  default-language: Haskell2010

executable broadcast
  import:           warnings
  main-is:          Main.hs
  build-depends:
    , base
    , moskstraumen

  hs-source-dirs:   app/broadcast
  default-language: Haskell2010

executable gset
  import:           warnings
  main-is:          Main.hs
  build-depends:
    , base
    , moskstraumen

  hs-source-dirs:   app/gset
  default-language: Haskell2010

executable kvstore
  import:           warnings
  main-is:          Main.hs
  build-depends:
    , base
    , moskstraumen

  hs-source-dirs:   app/kvstore
  default-language: Haskell2010

executable raft
  import:           warnings
  main-is:          Main.hs
  build-depends:
    , base
    , moskstraumen

  hs-source-dirs:   app/raft
  default-language: Haskell2010

executable blackbox-test
  import:           warnings
  main-is:          Main.hs
  build-depends:
    , base
    , moskstraumen

  hs-source-dirs:   app/blackbox-test
  default-language: Haskell2010

executable amaru
  import:           warnings
  main-is:          Main.hs
  build-depends:
    , base
    , moskstraumen

  hs-source-dirs:   app/amaru
  default-language: Haskell2010

executable debugger
  hs-source-dirs:   app/debugger

  if flag(debugger)
    main-is: Main.hs

  else
    main-is: DummyMain.hs

  build-depends:
    , base
    , moskstraumen

  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  default-language: Haskell2010

test-suite test
  import:           warnings, extensions
  default-language: Haskell2010
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    MessageCodec
  build-depends:
    , aeson
    , base
    , bytestring
    , moskstraumen
    , tasty
    , tasty-hunit
